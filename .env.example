# Copy to .env and fill in.  cp .env.example .env
#
# This file is the whole global configuration: which screens, in what order,
# for how long, on which device. Everything about how an individual screen
# looks lives in that screen's own folder, in its screen.json.
#
# BUILT AND TESTED ON A PIXOO 64. Pixoo is a product line and 16x16 and 32x32
# models exist. They should work by setting PIXOO_SIZE below, but that path is
# completely untested and display problems should be expected — every bundled
# screen's layout and artwork is drawn for a 64x64.

# ── Required ──────────────────────────────────────────────────────────────
# LAN address of your Pixoo 64. Find it in the Divoom app under
# Settings -> Device Info, and give it a DHCP reservation so it doesn't move.
PIXOO_IP=192.168.1.50


# ── What to display ───────────────────────────────────────────────────────
# Folder names from screens/, in rotation order.
# Leave blank or unset to rotate through every screen found.
#
# Add ":seconds" to any screen to override how long it stays up, e.g.
#   SCREENS=ltt,crypto,spacex:45,clock:10
SCREENS=ltt,crypto,spacex

# Default time each screen stays on display.
ROTATE_SECONDS=30

# 0-100. Above ~60 is uncomfortably bright in a dim room.
# A screen can override this with "brightness" in its screen.json.
PIXOO_BRIGHTNESS=40


# ── Device tuning ─────────────────────────────────────────────────────────
# Delay between commands sent to the device. Lower = snappier screen changes.
# The Pixoo drops commands that arrive back to back, so if text starts going
# missing, raise this again. 50 works here; 100 is the safe fallback.
PIXOO_COMMAND_DELAY_MS=50

# How long a screen's script may run before it's killed.
SCRIPT_TIMEOUT_SECONDS=30

# Right-aligned values stop this many pixels short of the right edge. Raise it
# if numbers look crammed against the edge, or if a character renders wider
# than pixhub thinks and occasionally spills over.
TEXT_RIGHT_MARGIN=2


# ── Status page ───────────────────────────────────────────────────────────
# Host port to reach it on: http://<this-host>:<port>
# Change it if something else already owns 8080.
PIXHUB_PORT=8080

# Set to false to not run the status server at all.
# HTTP_ENABLED=false


# ── Screen settings ───────────────────────────────────────────────────────
# Screen scripts inherit this whole file as environment variables, which is how
# they get API keys and options without anything being hardcoded.

# ltt — free key from https://console.cloud.google.com
# (enable "YouTube Data API v3" -> Credentials -> Create API key).
# The screen is skipped with a log line if this is blank.
YT_API_KEY=
# Point it at a different channel:
# YT_HANDLE=@LinusTechTips
# YT_CHANNEL_ID=UCXuqSBlHAE6Xw-yeJA0Tunw

# crypto — works with no key. A free demo key from
# https://www.coingecko.com/en/developers/dashboard raises the rate limit.
COINGECKO_API_KEY=
# CoinGecko ids, not tickers. Add more and raise "limit" in its screen.json.
# CRYPTO_COINS=bitcoin,ethereum
# CRYPTO_CURRENCY=usd

# spacex — works with no key. A free key from https://thespacedevs.com
# raises the rate limit.
LL_API_KEY=
# Any launch provider, or blank for the next launch worldwide.
# LAUNCH_PROVIDER=SpaceX

# testcard — a tool, not a display. Put SCREENS=testcard to check the font
# width table against your device: every line is drawn flush to the right edge,
# so a line that stops short or runs off means that character's width is wrong.
# Space separated; single characters are repeated, longer entries drawn as-is.
# TESTCARD_CHARS=$ , . % K M W
# TESTCARD_REPEAT=5

# fonttest — a tool, not a display. SCREENS=fonttest draws the same text at
# several of the device's font ids so you can see which it actually supports
# and how big each is. On this hardware f2 is the smallest of 0-7.
# FONTTEST_FONTS=0 1 2 3
# FONTTEST_TEXT=Ag8
# FONTTEST_STEP=16


# ── Misc ──────────────────────────────────────────────────────────────────
# Timezone for dates on the display, e.g. America/Los_Angeles, Europe/Berlin.
TZ=UTC

# debug | info | warn | error.  debug also shows what your scripts write to stderr.
LOG_LEVEL=info

# ── Advanced ──────────────────────────────────────────────────────────────
# Set for you by docker-compose; override only if you're running pixhub
# outside the provided stack.
#
# MODE=all                       all | gatherer | pusher
# PIXOO_BRIDGE=http://pixoo-rest:5000
# HTTP_HOST=0.0.0.0              interface the status page binds to
# HTTP_PORT=8080                 port *inside* the container (use PIXHUB_PORT
#                                to change the host port)
# SCREENS_DIR=screens            where to look for screen folders
# ASSETS_DIR=assets              where to look for shared images
# DATA_DIR=data                  where state.json is written


# Font width corrections, if text alignment looks off on your device.
# Only font 2 has been measured on real hardware; the rest are estimates.
# Check one with `npm run calibrate -- <font>`, then correct it here.
#
#   FONT_WIDTHS="M:8,W:8"   individual characters of font 2 (proportional)
#   FONT_WIDTH_4=7          advance for fixed-width font 4
# FONT_WIDTHS=
# FONT_WIDTH_4=

# Panel size. Pixoo is a product line, not one device — 16, 32 and 64 exist.
# Everything bundled here is built for the 64: artwork, row positions and the
# font measurements. Changing this makes the alignment maths follow a smaller
# panel, but you'd still have to redo every screen's layout, and it has not
# been tested on 16 or 32 hardware.
# PIXOO_SIZE=64
